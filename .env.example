# Supabase (server-only — the browser never talks to Supabase)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Resend
RESEND_API_KEY=
EMAIL_FROM="4Seas Residency <residency@mail.4seas.xyz>"
EMAIL_REPLY_TO=hello@4seas.xyz
# Development and Preview only. Code also defaults to this outside Vercel Production.
EMAIL_RECIPIENT_OVERRIDE=delivered+residency-preview@resend.dev

# Admin (single shared long password, >=32 random chars)
ADMIN_PASSWORD=
# Cookie signing secret (>=32 random chars)
SESSION_SECRET=

# Salt for hashing submitter IPs (rate limiting; raw IPs are never stored)
IP_HASH_SALT=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
